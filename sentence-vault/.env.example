# Set with `supabase secrets set` — never commit real values.
SENTENCE_VAULT_API_KEY=<A_LONG_RANDOM_STRING>

# Injected automatically by Supabase Edge Functions; only needed for local `supabase functions serve`.
SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SERVICE_ROLE_KEY>
