# Anthropic Claude API
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>
# Optional: any vision-capable Claude model
# CLAUDE_MODEL=claude-opus-4-6

# Readwise access token
READWISE_TOKEN=<YOUR_READWISE_TOKEN>

# Google service account (Drive API). Use ONE of:
GOOGLE_CREDENTIALS_FILE=credentials.json
# GOOGLE_CREDENTIALS_JSON=<full service-account JSON on one line>
# Drive folder paths (relative to the service account's view)
# DRIVE_PHOTOS_FOLDER=KindleSRS/MyPhotos
# DRIVE_ROOT_FOLDER=KindleSRS

# Email via Gmail SMTP + App Password
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=<YOUR_APP_PASSWORD>
SEND_TO_EMAIL=you@example.com

# Supabase
SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
SUPABASE_SERVICE_KEY=<YOUR_SERVICE_ROLE_KEY>

# Optional
# PHOTOS_PER_SESSION=2
# WORDS_PER_PHOTO=3
# CANDIDATE_POOL_SIZE=25
# TIMEZONE=UTC
